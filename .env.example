# Copy this file to .env.local for local development. Do not commit .env.local.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Use a unique random value of at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
# Optional: required only when public faculty self-registration is enabled.
FACULTY_REGISTRATION_CODE=
