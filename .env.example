# Copy this file to .env.local (never commit .env.local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/heard-in-class?retryWrites=true&w=majority
# At least 32 random characters. Required in production, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_URL=http://localhost:3000
# Optional. Leave empty to keep faculty self-registration OFF (admin creates faculty accounts).
# Set a secret code to let faculty register at /register/faculty with that code.
FACULTY_REGISTRATION_CODE=
